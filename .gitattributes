# Normalize line endings in the repository to LF regardless of platform.
* text=auto eol=lf

# Windows-native scripts keep CRLF in the working copy.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch binary artifacts.
*.bit  binary
*.bin  binary
*.xsa  binary
*.elf  binary
*.wdb  binary
*.png  binary
*.pdf  binary
